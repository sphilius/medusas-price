# Godot 4 generated / local-only files
.godot/
.import/
*.translation
export_credentials.cfg
# Web export output (rebuild with the Web preset)
build/
# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
# Secrets must never live in the Godot project (they belong in worker/ via wrangler secret)
.env
.dev.vars

# Design/reference PDFs live outside version control
*.pdf
*.PDF

# Full-quality music masters (about 200 MB); the game uses the OGGs that
# tools/build_music.py makes from them in audio/music/
audio/music_src/*.wav
